{
  "name": "be-hoc-vui",
  "version": "5.5.3",
  "private": true,
  "description": "Be Hoc Vui - Vietnamese kids learning app with Capacitor for Android and iOS",
  "scripts": {
    "cap:sync:ios": "cap sync ios",
    "cap:open:ios": "cap open ios",
    "cap:add:android": "cap add android",
    "cap:sync:android": "cap sync android",
    "cap:open:android": "cap open android",
    "assets:android": "capacitor-assets generate --android && python3 scripts/generate-android-icons.py",
    "build": "esbuild www/app.js --bundle --format=iife --target=es2020 --outfile=www/app.bundle.js"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.3",
    "@capacitor-community/text-to-speech": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@capacitor/ios": "^7.4.3",
    "@capacitor/android": "^7.4.3",
    "@capacitor/assets": "^3.0.5",
    "esbuild": "^0.25.0"
  }
}
